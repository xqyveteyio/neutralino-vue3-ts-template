{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.example.neutralino-vue3-ts",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "exportAuthInfo": true,
  "singlePageServe": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "window.*",
    "events.*",
    "debug.*",
    "storage.*",
    "clipboard.*",
    "computer.*",
    "filesystem.*"
  ],
  "modes": {
    "window": {
      "title": "Neutralino + Vue3 + TS",
      "width": 1000,
      "height": 680,
      "minWidth": 480,
      "minHeight": 360,
      "center": true,
      "icon": "/dist/icons/appIcon.png",
      "enableInspector": true,
      "exitProcessOnClose": false,
      "injectGlobals": true
    }
  },
  "cli": {
    "binaryName": "neutralino-vue3-ts",
    "resourcesPath": "/dist/",
    "binaryVersion": "6.8.0",
    "clientVersion": "6.8.0",
    "distributionPath": "/release",
    "resourcesExclude": ".*\\.map$",
    "frontendLibrary": {
      "patchFile": "/index.html",
      "devUrl": "http://localhost:5173",
      "projectPath": "/",
      "initCommand": "npm install",
      "devCommand": "npm run dev",
      "buildCommand": "npm run build",
      "waitTimeout": 60000
    }
  }
}
